# Normalize all text files in the repo to LF; check out as committed (no CRLF rewriting
# that would break bash scripts run through Git Bash on Windows).
* text=auto eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Shell scripts and Node ESM MUST be LF in the working tree (a CR in the shebang or
# heredoc breaks Git Bash execution).
*.sh text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf

# PowerShell tolerates LF; keep it explicit so Windows editors don't reintroduce CRLF churn.
*.ps1 text eol=lf

# Release manifests are byte-exact artifacts verified by tests/gen_release_manifest.sh
# --check (which diffs the frozen file against freshly generated LF output) and by
# sha256sum -c against release/manifests/MANIFEST-SHA256SUMS.txt. Pin LF so a Windows
# checkout cannot rewrite them to CRLF and break verification.
release/manifests/*.manifest text eol=lf
release/manifests/MANIFEST-SHA256SUMS.txt text eol=lf
release/manifests/FINAL_REF text eol=lf
